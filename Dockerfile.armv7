## Multistage build: fetch runtime dependencies for the target ARMv7 image
ARG ALPINE_IMAGE=alpine:3.23
ARG BUSYBOX_IMAGE=busybox:1.37.0-musl

FROM ${ALPINE_IMAGE} AS fetcher

RUN apk update && \
    apk --no-cache add ca-certificates mailcap && \
    wget -O /JSON.sh https://raw.githubusercontent.com/dominictarr/JSON.sh/0d5e5c77365f63809bf6e77ef44a1f34b0e05840/JSON.sh

## Final runtime image
FROM ${BUSYBOX_IMAGE}

ENV UID=1000
ENV GID=1000

# Create user group and user
RUN addgroup -g $GID vance && \
    adduser -D -u $UID -G vance vance

# Copy binary, scripts, and configurations into image with proper ownership
COPY --chown=vance:vance filebrowser /bin/filebrowser
COPY --chown=vance:vance docker/common/ /
COPY --chown=vance:vance docker/alpine/ /
COPY --from=fetcher /JSON.sh /JSON.sh
COPY --from=fetcher /etc/ca-certificates.conf /etc/ca-certificates.conf
COPY --from=fetcher /etc/ca-certificates /etc/ca-certificates
COPY --from=fetcher /etc/mime.types /etc/mime.types
COPY --from=fetcher /etc/ssl /etc/ssl

# Create data directories, set ownership, and ensure healthcheck script is executable
RUN mkdir -p /config /database /srv && \
    chown -R vance:vance /config /database /srv \
    && chmod +x /healthcheck.sh

HEALTHCHECK --start-period=2s --interval=5s --timeout=3s CMD /healthcheck.sh

USER vance

VOLUME /srv /config /database

EXPOSE 80

ENTRYPOINT [ "/init.sh" ]
